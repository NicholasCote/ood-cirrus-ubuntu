<?xml version="1.0" encoding="UTF-8"?>
<!--
  Window manager defaults.

  theme=Yaru-dark to match the GTK theme; without it xfwm4 falls back to
  "Default", whose titlebars are the most dated thing on the screen.

  use_compositing is off deliberately. Xkasmvnc is itself a compositing manager,
  and xfwm4 says so at start-up:
      xfwm4-WARNING: Another compositing manager is running on screen 0
  Leaving xfwm4's compositor enabled buys shadows and transparency that would be
  re-encoded as full-screen damage on every window move, over a proxied
  websocket. Off is both quieter in the log and cheaper on the wire.
-->
<channel name="xfwm4" version="1.0">
  <property name="general" type="empty">
    <property name="theme" type="string" value="Yaru-dark"/>
    <property name="title_font" type="string" value="Ubuntu Bold 11"/>
    <!--
      Nothing on the left, minimise/maximise/close on the right, which is how
      GNOME lays a titlebar out. The xfwm4 default is "O|SHMC": a window-menu
      button on the left and a shade button before the others on the right,
      both of which read as clutter next to a GNOME window and neither of which
      GNOME has.
    -->
    <property name="button_layout" type="string" value="|HMC"/>
    <property name="use_compositing" type="bool" value="false"/>
    <property name="click_to_focus" type="bool" value="true"/>
    <property name="snap_to_border" type="bool" value="true"/>
    <property name="snap_to_windows" type="bool" value="true"/>
    <property name="workspace_count" type="int" value="2"/>
  </property>
</channel>
